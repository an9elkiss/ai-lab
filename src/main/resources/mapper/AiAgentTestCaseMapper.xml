<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.weis.demo.mapper.AiAgentTestCaseMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.weis.demo.entity.AiAgentTestCase">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="case_name" property="caseName" jdbcType="VARCHAR"/>
        <result column="description" property="description" jdbcType="VARCHAR"/>
        <result column="case_type" property="caseType" jdbcType="VARCHAR"/>
        <result column="priority" property="priority" jdbcType="TINYINT"/>
        <result column="status" property="status" jdbcType="TINYINT"/>
        <result column="user_input_text" property="userInputText" jdbcType="VARCHAR"/>
        <result column="user_input_image_url" property="userInputImageUrl" jdbcType="VARCHAR"/>
        <result column="session_context" property="sessionContext" jdbcType="VARCHAR"/>
        <result column="handler" property="handler" jdbcType="VARCHAR"/>
        <result column="expected_intent_type" property="expectedIntentType" jdbcType="VARCHAR"/>
        <result column="expected_subsequent_flow" property="expectedSubsequentFlow" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="last_modify_time" property="lastModifyTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- 基础字段 -->
    <sql id="Base_Column_List">
        id, case_name, description, case_type, priority, status,
        user_input_text, user_input_image_url, session_context, handler,
        expected_intent_type, expected_subsequent_flow,
        create_time, last_modify_time
    </sql>

    <!-- 插入 -->
    <insert id="insert" parameterType="com.weis.demo.entity.AiAgentTestCase" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_ai_agent_test_case (
            case_name,
            description,
            case_type,
            priority,
            status,
            user_input_text,
            user_input_image_url,
            session_context,
            handler,
            expected_intent_type,
            expected_subsequent_flow
        ) VALUES (
            #{caseName},
            #{description},
            #{caseType},
            #{priority},
            #{status},
            #{userInputText},
            #{userInputImageUrl},
            #{sessionContext},
            #{handler},
            #{expectedIntentType},
            #{expectedSubsequentFlow}
        )
    </insert>

    <!-- 根据ID删除 -->
    <delete id="deleteById" parameterType="long">
        DELETE FROM t_ai_agent_test_case
        WHERE id = #{id}
    </delete>

    <!-- 更新 -->
    <update id="update" parameterType="com.weis.demo.entity.AiAgentTestCase">
        UPDATE t_ai_agent_test_case
        <set>
            <if test="caseName != null and caseName != ''">
                case_name = #{caseName},
            </if>
            <if test="description != null">
                description = #{description},
            </if>
            <if test="caseType != null and caseType != ''">
                case_type = #{caseType},
            </if>
            <if test="priority != null">
                priority = #{priority},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="userInputText != null">
                user_input_text = #{userInputText},
            </if>
            <if test="userInputImageUrl != null">
                user_input_image_url = #{userInputImageUrl},
            </if>
            <if test="sessionContext != null">
                session_context = #{sessionContext},
            </if>
            <if test="handler != null">
                handler = #{handler},
            </if>
            <if test="expectedIntentType != null">
                expected_intent_type = #{expectedIntentType},
            </if>
            <if test="expectedSubsequentFlow != null">
                expected_subsequent_flow = #{expectedSubsequentFlow},
            </if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 根据ID查询 -->
    <select id="selectById" parameterType="long" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_ai_agent_test_case
        WHERE id = #{id}
    </select>

    <!-- 查询所有 -->
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_ai_agent_test_case
        ORDER BY create_time DESC
    </select>

    <!-- 根据用例类型查询 -->
    <select id="selectByCaseType" parameterType="string" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_ai_agent_test_case
        WHERE case_type = #{caseType}
        ORDER BY create_time DESC
    </select>

    <!-- 根据状态查询 -->
    <select id="selectByStatus" parameterType="int" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_ai_agent_test_case
        WHERE status = #{status}
        ORDER BY create_time DESC
    </select>

    <!-- 根据优先级查询 -->
    <select id="selectByPriority" parameterType="int" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_ai_agent_test_case
        WHERE priority = #{priority}
        ORDER BY create_time DESC
    </select>

    <!-- 根据条件查询 -->
    <select id="findByCondition" parameterType="com.weis.demo.dto.command.AiAgentTestCaseFindCmd" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_ai_agent_test_case
        <where>
            <if test="cmd.caseName != null and cmd.caseName != ''">
                AND case_name LIKE CONCAT('%', #{cmd.caseName}, '%')
            </if>
            <if test="cmd.caseNames != null and cmd.caseNames.size() > 0">
                AND case_name IN
                <foreach collection="cmd.caseNames" item="name" open="(" separator="," close=")">
                    #{name}
                </foreach>
            </if>
            <if test="cmd.caseType != null and cmd.caseType != ''">
                AND case_type = #{cmd.caseType}
            </if>
            <if test="cmd.priority != null">
                AND priority = #{cmd.priority}
            </if>
            <if test="cmd.status != null">
                AND status = #{cmd.status}
            </if>
        </where>
    </select>

</mapper>
